        "jwks-rsa": "^3.2.2",
        "oauth2-server": "^3.1.1"
    },
    "overrides_comment": "We override type-is as is conflicting with body-parser",
    "overrides": {
        "oauth2-server": {
            "type-is": "2.0.1"
        }
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
